---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us | Smart Health Clinic"
  description="Get in touch with Smart Health Clinic in Kathmandu for appointments and inquiries."
>
  <!-- HERO -->
  <section class="bg-primary-color text-white py-10">
    <div class="container mx-auto px-6 max-w-5xl text-center">
      <h1 data-t="contact_hero_title" class="text-4xl md:text-6xl font-black mb-6"></h1>

      <p data-t="contact_hero_desc" class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto"></p>
    </div>
  </section>

  <!-- CONTACT DETAILS + MAP -->
  <section class="py-10 bg-white text-primary-color">
    <div class="container mx-auto px-6 max-w-6xl grid lg:grid-cols-2 gap-10 items-start">
      <!-- LEFT INFO -->
      <div class="space-y-10">
        <!-- Contact Section -->
        <div>
          <h2 data-t="contact_section_title" class="text-3xl font-bold mb-6"></h2>

          <div class="space-y-4 text-lg">
            <p>
              <span data-t="contact_location_label"></span>:
              <span data-t="contact_location"></span>
            </p>

            <p>
              <span data-t="contact_phone_label"></span>:
              <span data-t="contact_phone"></span>
            </p>

            <p data-t="contact_time"></p>

            <p class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 text-primary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d="M3 8l9 6 9-6M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"
                ></path>
              </svg>

              <span data-t="contact_email_label"></span>:
              <a href="mailto:info@smarthealthnepal.com" class="text-primary hover:underline">
                info@smarthealthnepal.com
              </a>
            </p>
          </div>
        </div>

        <!-- Info Section -->
        <div>
          <h2 data-t="contact_section_title_2" class="text-3xl font-bold mb-4"></h2>
          <p data-t="contact_section_info_2" class="text-lg"></p>
        </div>
      </div>

      <!-- RIGHT MAP -->
      <div class="rounded-2xl overflow-hidden shadow-lg border">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3532.777128931389!2d85.36649781036867!3d27.693282426013614!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39eb1b0054415ff9%3A0xe624334cca561124!2sSmart%20Health%20Clinic%2CPepsicola!5e0!3m2!1sen!2sus!4v1777928908889!5m2!1sen!2sus"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        >
        </iframe>
      </div>
    </div>
  </section>

  <!-- QUICK CONTACT -->
  <section class="py-10 bg-slate-50 text-primary-color">
    <div class="container mx-auto px-6 max-w-5xl text-center">
      <h2 data-t="contact_quick_title" class="text-3xl font-bold mb-4"></h2>

      <p data-t="contact_quick_desc" class="mb-10"></p>

      <div class="grid sm:grid-cols-2 gap-6">
        <a
          href="tel:015923005"
          class="bg-white border rounded-2xl p-6 shadow-sm hover:shadow-md transition"
        >
          <div class="text-4xl mb-2">📞</div>
          <h3 data-t="contact_call_card_title" class="font-bold"></h3>
          <p data-t="contact_call_card_desc" class="text-sm mt-1"></p>
        </a>

        <a
          href="https://wa.me/9779704543137?text=Hello%20Smart%20Health%20Clinic,%20I%20would%20like%20to%20book%20an%20appointment."
          target="_blank"
          class="bg-white border rounded-2xl p-6 shadow-sm hover:shadow-md transition"
        >
          <div class="text-4xl mb-2">💬</div>
          <h3 data-t="contact_whatsapp_card_title" class="font-bold"></h3>
          <p data-t="contact_whatsapp_card_desc" class="text-sm mt-1"></p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-10 bg-primary-color text-white text-center">
    <div class="container mx-auto px-6 max-w-3xl">
      <h2 data-t="contact_cta_title" class="text-3xl font-bold mb-4"></h2>

      <p data-t="contact_cta_desc" class="text-slate-300 mb-8"></p>

      <a
        href="https://vendor.smarthealthnepal.com/"
        target="_blank"
        rel="noopener noreferrer"
        data-t="contact_cta_btn"
        class="bg-secondary-color px-7 py-3 rounded-full font-bold inline-block"></a>
    </div>
  </section>
</Layout>

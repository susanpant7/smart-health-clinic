---
import Layout from '../../layouts/Layout.astro';
import doctors from '../../data/doctors.json';
import ImageSlider from '../../components/ImageSlider.astro';
import { doctorImages } from '../../data/doctors-images';
---

<Layout
  title="Our Doctors | Smart Health Clinic"
  description="Meet experienced doctors at Smart Health Clinic in Kathmandu."
>
  <!-- HERO -->
  <section class="bg-primary-color text-white py-20">
    <div class="container mx-auto px-6 max-w-5xl text-center">
      <h1 data-t="doctors_hero_title" class="text-4xl md:text-6xl font-black mb-6"></h1>

      <p data-t="doctors_hero_desc" class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto"></p>
      <p data-t="doctors_intro_desc" class="text-slate-300 leading-relaxed"></p>
    </div>
  </section>



  <!-- MEET THE TEAM -->
  <section class="py-20 bg-slate-50 text-primary-color">
    <div class="container mx-auto px-6 max-w-6xl">

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 text-primary font-bold">
        {
          doctors.map((doc) => (
            <div class="group relative text-center bg-white rounded-xl p-4 shadow-sm hover:shadow-lg transition duration-300 flex flex-col justify-between h-full">
              <div>
                <div class="relative">
                  <img
                    src={`/images/doctors/dp/${doc.image}`}
                    alt={doc.name.en}
                    class="w-32 h-32 mx-auto rounded-full object-cover transition duration-300 group-hover:scale-105"
                    onerror="this.onerror=null; this.src='/fallback-doctor.png'"
                    loading="lazy"
                  />
                </div>

                <h1
                  class="mt-3 font-semibold text-base"
                  data-value-en={doc.name.en}
                  data-value-ne={doc.name.ne}
                >
                  {doc.name.en}
                </h1>

                <p
                  class="text-sm font-medium opacity-90"
                  data-value-en={doc.specialty.en}
                  data-value-ne={doc.specialty.ne}
                >
                  {doc.specialty.en}
                </p>

                <p class="text-xs font-normal mt-1 opacity-70">{doc.qualification}</p>

                <p class="text-xs font-normal mt-1 text-secondary-color">{doc.nmc}</p>
              </div>

              {/* View Info Action Target Wrapper */}
              <div class="mt-4 pt-2">
                {/* CRITICAL FIX: 
            - Changed wrapping button to a semantic <div> to prevent invalid nested interactive element structures.
            - Added 'after:absolute after:inset-0' to stretch the click layer across the parent group box container.
          */}
                <div class="w-full py-2 px-4 text-xs font-semibold rounded-lg border border-slate-200 text-slate-700 group-hover:bg-slate-50 group-active:scale-[0.98] transition duration-200">
                  <a
                    href={`/doctors/${doc.id}`}
                    class="after:absolute after:inset-0 focus:outline-none"
                  >
                    View Info
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pt-10 bg-primary-color text-white text-center">
    <div class="container mx-auto px-6 max-w-3xl">
      <h2 data-t="doctors_cta_title" class="text-3xl font-bold mb-4"></h2>

      <p data-t="doctors_cta_desc" class="text-slate-300 mb-8"></p>

      <a
        href="https://vendor.smarthealthnepal.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-secondary-color px-7 py-3 rounded-full font-bold inline-block"
      >
        <span data-t="doctors_cta_btn"></span>
      </a>
    </div>
  </section>
</Layout>
